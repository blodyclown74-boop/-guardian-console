{
  "name": "guardian-console",
  "main": "worker.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./Frontend",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guardian-console-db",
      "database_id": "0783293d-ef2d-4e6e-9fd4-601978735a23",
      "migrations_dir": "migrations"
    }
  ]
}
